# Containerlab Topology Definition for ECMP Hash Testing
# 
# This topology implements an N-path ECMP network for testing hash algorithms
# based on Source IP address only.
#
# Reference: https://containerlab.dev/manual/
# Architecture: ARCHITECTURE.md
#
# Generated from Jinja2 template with num_paths={{ num_paths }}

name: ecmp-test-{{ num_paths }}-paths

topology:
  # Default node configuration
  defaults:
    kind: linux
    image: frrouting/frr:latest
    # Wait for FRR daemons to be ready
    wait-for: 10s

  # Network nodes definition
  nodes:
    # Source Network Hosts
    h1:
      kind: linux
      image: alpine:latest
      cmd: ip addr add 10.0.1.10/24 dev eth0 && ip route add default via 10.0.1.1 && tail -f /dev/null
      binds:
        - ./configs/hosts/h1.sh:/etc/init.d/network.sh:ro

    h2:
      kind: linux
      image: alpine:latest
      cmd: ip addr add 10.0.1.11/24 dev eth0 && ip route add default via 10.0.1.1 && tail -f /dev/null
      binds:
        - ./configs/hosts/h2.sh:/etc/init.d/network.sh:ro

    h3:
      kind: linux
      image: alpine:latest
      cmd: ip addr add 10.0.1.12/24 dev eth0 && ip route add default via 10.0.1.1 && tail -f /dev/null
      binds:
        - ./configs/hosts/h3.sh:/etc/init.d/network.sh:ro

    h4:
      kind: linux
      image: alpine:latest
      cmd: ip addr add 10.0.1.13/24 dev eth0 && ip route add default via 10.0.1.1 && tail -f /dev/null
      binds:
        - ./configs/hosts/h4.sh:/etc/init.d/network.sh:ro

    # Edge Router (R1) - Implements ECMP
    # This router has {{ num_paths }} equal-cost paths to the destination network
    r1:
      kind: linux
      image: frrouting/frr:latest
      # Bind FRR configuration files
      binds:
        - ./configs/frr/r1/frr.conf:/etc/frr/frr.conf:ro
        - ./configs/frr/r1/daemons:/etc/frr/daemons:ro
        - ./configs/frr/r1/vtysh.conf:/etc/frr/vtysh.conf:ro
        - ./topology/frr/sysctl.d/hash-policy.conf:/etc/sysctl.d/hash-policy.conf:ro
      # Startup commands to configure interfaces
      startup-config: |
        # Configure source network interface
        ip addr add 10.0.1.1/24 dev eth0
        ip link set eth0 up
        {% for i in range(1, num_paths + 1) %}
        # Configure ECMP path {{ i }} interface
        ip addr add 10.0.{{ i + 1 }}.1/24 dev eth{{ i }}
        ip link set eth{{ i }} up
        {% endfor %}
        # Enable IP forwarding
        sysctl -w net.ipv4.ip_forward=1
        # Apply ECMP hash policy
        sysctl -p /etc/sysctl.d/hash-policy.conf
        # Start FRR daemons
        /usr/lib/frr/frrinit.sh start

{% for i in range(1, num_paths + 1) %}
    # Core Router {{ i }} (R{{ i + 1 }}) - ECMP Path {{ i }}
    r{{ i + 1 }}:
      kind: linux
      image: frrouting/frr:latest
      binds:
        - ./configs/frr/r{{ i + 1 }}/frr.conf:/etc/frr/frr.conf:ro
        - ./configs/frr/r{{ i + 1 }}/daemons:/etc/frr/daemons:ro
        - ./configs/frr/r{{ i + 1 }}/vtysh.conf:/etc/frr/vtysh.conf:ro
      startup-config: |
        # Configure interface to edge router
        ip addr add 10.0.{{ i + 1 }}.2/24 dev eth0
        ip link set eth0 up
        # Configure interface to destination router
        ip addr add 10.0.{{ num_paths + i + 1 }}.1/24 dev eth1
        ip link set eth1 up
        # Enable IP forwarding
        sysctl -w net.ipv4.ip_forward=1
        # Start FRR daemons
        /usr/lib/frr/frrinit.sh start

{% endfor %}
    # Destination Router (R{{ num_paths + 2 }})
    r{{ num_paths + 2 }}:
      kind: linux
      image: frrouting/frr:latest
      binds:
        - ./configs/frr/r{{ num_paths + 2 }}/frr.conf:/etc/frr/frr.conf:ro
        - ./configs/frr/r{{ num_paths + 2 }}/daemons:/etc/frr/daemons:ro
        - ./configs/frr/r{{ num_paths + 2 }}/vtysh.conf:/etc/frr/vtysh.conf:ro
      startup-config: |
{% for i in range(1, num_paths + 1) %}
        # Configure interface to core router {{ i }}
        ip addr add 10.0.{{ num_paths + i + 1 }}.2/24 dev eth{{ i - 1 }}
        ip link set eth{{ i - 1 }} up
{% endfor %}
        # Configure destination network interface
        ip addr add 192.168.100.1/24 dev eth{{ num_paths }}
        ip link set eth{{ num_paths }} up
        # Enable IP forwarding
        sysctl -w net.ipv4.ip_forward=1
        # Start FRR daemons
        /usr/lib/frr/frrinit.sh start

    # Destination Host
    d1:
      kind: linux
      image: alpine:latest
      cmd: ip addr add 192.168.100.10/24 dev eth0 && ip route add default via 192.168.100.1 && tail -f /dev/null
      binds:
        - ./configs/hosts/d1.sh:/etc/init.d/network.sh:ro

  # Links definition - defines the network connections
  links:
    # Source network connections
    - endpoints: ["h1:eth0", "r1:eth0"]
    - endpoints: ["h2:eth0", "r1:eth0"]
    - endpoints: ["h3:eth0", "r1:eth0"]
    - endpoints: ["h4:eth0", "r1:eth0"]

{% for i in range(1, num_paths + 1) %}
    # ECMP path {{ i }}: R1 -> R{{ i + 1 }}
    - endpoints: ["r1:eth{{ i }}", "r{{ i + 1 }}:eth0"]

{% endfor %}
    # Core router to destination router connections
{% for i in range(1, num_paths + 1) %}
    - endpoints: ["r{{ i + 1 }}:eth1", "r{{ num_paths + 2 }}:eth{{ i - 1 }}"]
{% endfor %}

    # Destination network connection
    - endpoints: ["r{{ num_paths + 2 }}:eth{{ num_paths }}", "d1:eth0"]
