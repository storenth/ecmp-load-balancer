#!/bin/bash

################################################################################
# Pre-commit Hook for ECMP Testing Project
################################################################################
# This pre-commit hook validates scripts and configuration files before commit.
# It performs syntax checking, formatting validation, and basic validation.
#
# Reference: https://git-scm.com/docs/githooks
# Architecture: ARCHITECTURE.md - Testing Framework Architecture
# Best Practices: Pre-commit Hook Best Practices
#
# Usage:
#   This hook is automatically executed by Git before each commit.
#   To bypass this hook (not recommended), use: git commit --no-verify
#
# Validations:
#   - Shell script syntax checking
#   - YAML syntax validation
#   - Python syntax checking
#   - Script executable permissions
#   - Configuration file validation
#   - Dockerfile validation
#   - Workflow file validation
################################################################################

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Counters
ERRORS=0
WARNINGS=0
CHECKS_PASSED=0
CHECKS_FAILED=0

# Project root directory
PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# =============================================================================
# Utility Functions
# =============================================================================

# Print colored message
print_message() {
    local level="$1"
    shift
    local message="$*"
    
    case "$level" in
        error)
            echo -e "${RED}[ERROR]${NC} $message"
            ;;
        warning)
            echo -e "${YELLOW}[WARNING]${NC} $message"
            ;;
        success)
            echo -e "${GREEN}[SUCCESS]${NC} $message"
            ;;
        info)
            echo -e "${BLUE}[INFO]${NC} $message"
            ;;
        *)
            echo "$message"
            ;;
    esac
}

# Print section header
print_section() {
    echo ""
    echo "=========================================="
    echo "$1"
    echo "=========================================="
}

# Check if a command exists
command_exists() {
    command -v "$1" &> /dev/null
}

# Get list of staged files
get_staged_files() {
    git diff --cached --name-only --diff-filter=ACM
}

# Get list of changed files (including unstaged)
get_changed_files() {
    git diff --name-only --diff-filter=ACM
}

# =============================================================================
# Validation Functions
# =============================================================================

# Validate shell script syntax
validate_shell_scripts() {
    print_section "Validating Shell Scripts"
    
    local shell_files=()
    
    # Find staged shell scripts
    while IFS= read -r file; do
        if [[ "$file" =~ \.(sh|bash)$ ]]; then
            shell_files+=("$file")
        fi
    done < <(get_staged_files)
    
    if [[ ${#shell_files[@]} -eq 0 ]]; then
        print_message info "No shell scripts to validate"
        return 0
    fi
    
    print_message info "Found ${#shell_files[@]} shell script(s) to validate"
    
    for file in "${shell_files[@]}"; do
        local filepath="${PROJECT_ROOT}/${file}"
        
        print_message info "Validating: $file"
        
        # Check if file exists
        if [[ ! -f "$filepath" ]]; then
            print_message error "File not found: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
            continue
        fi
        
        # Check shebang
        if ! head -n 1 "$filepath" | grep -qE '^#!(/bin/bash|/usr/bin/env bash|/bin/sh|/usr/bin/env sh)'; then
            print_message warning "Missing or invalid shebang in: $file"
            ((WARNINGS++))
        fi
        
        # Check syntax with bash -n
        if bash -n "$filepath" 2>&1; then
            print_message success "Syntax OK: $file"
            ((CHECKS_PASSED++))
        else
            print_message error "Syntax error in: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
        fi
        
        # Check for common issues
        if grep -qE '\t' "$filepath"; then
            print_message warning "Contains tabs (use spaces): $file"
            ((WARNINGS++))
        fi
        
        # Check for trailing whitespace
        if grep -qE ' +$' "$filepath"; then
            print_message warning "Contains trailing whitespace: $file"
            ((WARNINGS++))
        fi
        
        # Check for executable permission
        if [[ ! -x "$filepath" ]]; then
            print_message warning "Not executable: $file"
            ((WARNINGS++))
        fi
    done
}

# Validate YAML files
validate_yaml_files() {
    print_section "Validating YAML Files"
    
    local yaml_files=()
    
    # Find staged YAML files
    while IFS= read -r file; do
        if [[ "$file" =~ \.(yaml|yml)$ ]]; then
            yaml_files+=("$file")
        fi
    done < <(get_staged_files)
    
    if [[ ${#yaml_files[@]} -eq 0 ]]; then
        print_message info "No YAML files to validate"
        return 0
    fi
    
    print_message info "Found ${#yaml_files[@]} YAML file(s) to validate"
    
    # Check for yq or python
    local yaml_validator=""
    if command_exists yq; then
        yaml_validator="yq"
    elif command_exists python3 && python3 -c "import yaml" 2>/dev/null; then
        yaml_validator="python"
    else
        print_message warning "No YAML validator found (yq or python with PyYAML)"
        return 0
    fi
    
    for file in "${yaml_files[@]}"; do
        local filepath="${PROJECT_ROOT}/${file}"
        
        print_message info "Validating: $file"
        
        # Check if file exists
        if [[ ! -f "$filepath" ]]; then
            print_message error "File not found: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
            continue
        fi
        
        # Validate YAML syntax
        if [[ "$yaml_validator" == "yq" ]]; then
            if yq eval '.' "$filepath" > /dev/null 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            else
                print_message error "Syntax error in: $file"
                ((ERRORS++))
                ((CHECKS_FAILED++))
            fi
        elif [[ "$yaml_validator" == "python" ]]; then
            if python3 -c "import yaml; yaml.safe_load(open('$filepath'))" 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            else
                print_message error "Syntax error in: $file"
                ((ERRORS++))
                ((CHECKS_FAILED++))
            fi
        fi
        
        # Check for common issues
        if grep -qE '\t' "$filepath"; then
            print_message warning "Contains tabs (use spaces): $file"
            ((WARNINGS++))
        fi
        
        # Check for trailing whitespace
        if grep -qE ' +$' "$filepath"; then
            print_message warning "Contains trailing whitespace: $file"
            ((WARNINGS++))
        fi
    done
}

# Validate Python files
validate_python_files() {
    print_section "Validating Python Files"
    
    local python_files=()
    
    # Find staged Python files
    while IFS= read -r file; do
        if [[ "$file" =~ \.py$ ]]; then
            python_files+=("$file")
        fi
    done < <(get_staged_files)
    
    if [[ ${#python_files[@]} -eq 0 ]]; then
        print_message info "No Python files to validate"
        return 0
    fi
    
    print_message info "Found ${#python_files[@]} Python file(s) to validate"
    
    # Check for python3
    if ! command_exists python3; then
        print_message warning "Python 3 not found, skipping Python validation"
        return 0
    fi
    
    for file in "${python_files[@]}"; do
        local filepath="${PROJECT_ROOT}/${file}"
        
        print_message info "Validating: $file"
        
        # Check if file exists
        if [[ ! -f "$filepath" ]]; then
            print_message error "File not found: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
            continue
        fi
        
        # Check syntax with python3 -m py_compile
        if python3 -m py_compile "$filepath" 2>&1; then
            print_message success "Syntax OK: $file"
            ((CHECKS_PASSED++))
        else
            print_message error "Syntax error in: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
        fi
        
        # Check for common issues
        if grep -qE '\t' "$filepath"; then
            print_message warning "Contains tabs (use spaces): $file"
            ((WARNINGS++))
        fi
        
        # Check for trailing whitespace
        if grep -qE ' +$' "$filepath"; then
            print_message warning "Contains trailing whitespace: $file"
            ((WARNINGS++))
        fi
    done
}

# Validate Dockerfile
validate_dockerfile() {
    print_section "Validating Dockerfile"
    
    local dockerfile_found=false
    
    # Check if Dockerfile is staged
    while IFS= read -r file; do
        if [[ "$file" == "Dockerfile" ]] || [[ "$file" =~ ^Dockerfile\. ]]; then
            dockerfile_found=true
            local filepath="${PROJECT_ROOT}/${file}"
            
            print_message info "Validating: $file"
            
            # Check if file exists
            if [[ ! -f "$filepath" ]]; then
                print_message error "File not found: $file"
                ((ERRORS++))
                ((CHECKS_FAILED++))
                continue
            fi
            
            # Check for hadolint (Dockerfile linter)
            if command_exists hadolint; then
                if hadolint "$filepath" 2>&1; then
                    print_message success "Linting OK: $file"
                    ((CHECKS_PASSED++))
                else
                    print_message warning "Linting issues found in: $file"
                    ((WARNINGS++))
                fi
            else
                print_message info "hadolint not found, skipping Dockerfile linting"
            fi
            
            # Check for common issues
            if grep -qE 'latest$' "$filepath"; then
                print_message warning "Uses 'latest' tag (consider specific version): $file"
                ((WARNINGS++))
            fi
            
            # Check for trailing whitespace
            if grep -qE ' +$' "$filepath"; then
                print_message warning "Contains trailing whitespace: $file"
                ((WARNINGS++))
            fi
        fi
    done < <(get_staged_files)
    
    if [[ "$dockerfile_found" == false ]]; then
        print_message info "No Dockerfile to validate"
    fi
}

# Validate GitHub Actions workflow files
validate_workflow_files() {
    print_section "Validating GitHub Actions Workflow Files"
    
    local workflow_files=()
    
    # Find staged workflow files
    while IFS= read -r file; do
        if [[ "$file" =~ ^\.github/workflows/.*\.yml$ ]] || [[ "$file" =~ ^\.github/workflows/.*\.yaml$ ]]; then
            workflow_files+=("$file")
        fi
    done < <(get_staged_files)
    
    if [[ ${#workflow_files[@]} -eq 0 ]]; then
        print_message info "No workflow files to validate"
        return 0
    fi
    
    print_message info "Found ${#workflow_files[@]} workflow file(s) to validate"
    
    # Check for yq or python
    local yaml_validator=""
    if command_exists yq; then
        yaml_validator="yq"
    elif command_exists python3 && python3 -c "import yaml" 2>/dev/null; then
        yaml_validator="python"
    else
        print_message warning "No YAML validator found (yq or python with PyYAML)"
        return 0
    fi
    
    for file in "${workflow_files[@]}"; do
        local filepath="${PROJECT_ROOT}/${file}"
        
        print_message info "Validating: $file"
        
        # Check if file exists
        if [[ ! -f "$filepath" ]]; then
            print_message error "File not found: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
            continue
        fi
        
        # Validate YAML syntax
        if [[ "$yaml_validator" == "yq" ]]; then
            if yq eval '.' "$filepath" > /dev/null 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            else
                print_message error "Syntax error in: $file"
                ((ERRORS++))
                ((CHECKS_FAILED++))
            fi
        elif [[ "$yaml_validator" == "python" ]]; then
            if python3 -c "import yaml; yaml.safe_load(open('$filepath'))" 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            else
                print_message error "Syntax error in: $file"
                ((ERRORS++))
                ((CHECKS_FAILED++))
            fi
        fi
        
        # Check for required fields
        if ! grep -qE '^name:' "$filepath"; then
            print_message warning "Missing 'name' field in: $file"
            ((WARNINGS++))
        fi
        
        if ! grep -qE '^on:' "$filepath"; then
            print_message warning "Missing 'on' field in: $file"
            ((WARNINGS++))
        fi
        
        if ! grep -qE '^jobs:' "$filepath"; then
            print_message warning "Missing 'jobs' field in: $file"
            ((WARNINGS++))
        fi
    done
}

# Validate configuration files
validate_config_files() {
    print_section "Validating Configuration Files"
    
    local config_files=()
    
    # Find staged configuration files
    while IFS= read -r file; do
        if [[ "$file" =~ ^(configs/|\.github/config/).*\.(yaml|yml|json|conf)$ ]]; then
            config_files+=("$file")
        fi
    done < <(get_staged_files)
    
    if [[ ${#config_files[@]} -eq 0 ]]; then
        print_message info "No configuration files to validate"
        return 0
    fi
    
    print_message info "Found ${#config_files[@]} configuration file(s) to validate"
    
    for file in "${config_files[@]}"; do
        local filepath="${PROJECT_ROOT}/${file}"
        
        print_message info "Validating: $file"
        
        # Check if file exists
        if [[ ! -f "$filepath" ]]; then
            print_message error "File not found: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
            continue
        fi
        
        # Validate based on file type
        if [[ "$file" =~ \.(yaml|yml)$ ]]; then
            # Validate YAML
            if command_exists yq && yq eval '.' "$filepath" > /dev/null 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            elif command_exists python3 && python3 -c "import yaml; yaml.safe_load(open('$filepath'))" 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            else
                print_message warning "Could not validate YAML syntax: $file"
                ((WARNINGS++))
            fi
        elif [[ "$file" =~ \.json$ ]]; then
            # Validate JSON
            if command_exists jq && jq empty "$filepath" 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            elif command_exists python3 && python3 -c "import json; json.load(open('$filepath'))" 2>&1; then
                print_message success "Syntax OK: $file"
                ((CHECKS_PASSED++))
            else
                print_message warning "Could not validate JSON syntax: $file"
                ((WARNINGS++))
            fi
        fi
        
        # Check for trailing whitespace
        if grep -qE ' +$' "$filepath"; then
            print_message warning "Contains trailing whitespace: $file"
            ((WARNINGS++))
        fi
    done
}

# Validate script permissions
validate_script_permissions() {
    print_section "Validating Script Permissions"
    
    local script_files=()
    
    # Find staged script files
    while IFS= read -r file; do
        if [[ "$file" =~ ^(scripts/|\.github/hooks/).*\.(sh|bash|py)$ ]]; then
            script_files+=("$file")
        fi
    done < <(get_staged_files)
    
    if [[ ${#script_files[@]} -eq 0 ]]; then
        print_message info "No script files to validate"
        return 0
    fi
    
    print_message info "Found ${#script_files[@]} script file(s) to validate"
    
    for file in "${script_files[@]}"; do
        local filepath="${PROJECT_ROOT}/${file}"
        
        print_message info "Checking: $file"
        
        # Check if file exists
        if [[ ! -f "$filepath" ]]; then
            print_message error "File not found: $file"
            ((ERRORS++))
            ((CHECKS_FAILED++))
            continue
        fi
        
        # Check if file is executable
        if [[ -x "$filepath" ]]; then
            print_message success "Executable: $file"
            ((CHECKS_PASSED++))
        else
            print_message warning "Not executable: $file"
            ((WARNINGS++))
        fi
    done
}

# Check for common issues
check_common_issues() {
    print_section "Checking for Common Issues"
    
    # Check for large files
    while IFS= read -r file; do
        local filepath="${PROJECT_ROOT}/${file}"
        if [[ -f "$filepath" ]]; then
            local size=$(stat -f%z "$filepath" 2>/dev/null || stat -c%s "$filepath" 2>/dev/null)
            local size_mb=$((size / 1024 / 1024))
            
            if [[ $size_mb -gt 10 ]]; then
                print_message warning "Large file (>10MB): $file (${size_mb}MB)"
                ((WARNINGS++))
            fi
        fi
    done < <(get_staged_files)
    
    # Check for binary files
    while IFS= read -r file; do
        local filepath="${PROJECT_ROOT}/${file}"
        if [[ -f "$filepath" ]]; then
            if file "$filepath" | grep -qE '(binary|executable)'; then
                if [[ ! "$file" =~ \.(png|jpg|jpeg|gif|ico|pdf|zip|tar|gz)$ ]]; then
                    print_message warning "Binary file: $file"
                    ((WARNINGS++))
                fi
            fi
        fi
    done < <(get_staged_files)
    
    # Check for TODO/FIXME comments
    while IFS= read -r file; do
        local filepath="${PROJECT_ROOT}/${file}"
        if [[ -f "$filepath" ]]; then
            if grep -qE 'TODO|FIXME|XXX|HACK' "$filepath"; then
                print_message info "Contains TODO/FIXME comments: $file"
            fi
        fi
    done < <(get_staged_files)
}

# =============================================================================
# Main Execution
# =============================================================================

main() {
    print_section "ECMP Testing Pre-commit Hook"
    print_message info "Validating staged files..."
    
    # Run all validations
    validate_shell_scripts
    validate_yaml_files
    validate_python_files
    validate_dockerfile
    validate_workflow_files
    validate_config_files
    validate_script_permissions
    check_common_issues
    
    # Print summary
    print_section "Validation Summary"
    print_message info "Checks Passed: $CHECKS_PASSED"
    print_message info "Checks Failed: $CHECKS_FAILED"
    print_message warning "Warnings: $WARNINGS"
    print_message error "Errors: $ERRORS"
    
    # Exit with appropriate code
    if [[ $ERRORS -gt 0 ]]; then
        print_message error "Pre-commit hook failed with $ERRORS error(s)"
        print_message info "To bypass this hook (not recommended), use: git commit --no-verify"
        exit 1
    elif [[ $WARNINGS -gt 0 ]]; then
        print_message warning "Pre-commit hook passed with $WARNINGS warning(s)"
        exit 0
    else
        print_message success "Pre-commit hook passed successfully"
        exit 0
    fi
}

# Run main function
main
