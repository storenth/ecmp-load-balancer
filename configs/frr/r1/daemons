#
# FRRouting Daemons Configuration for Edge Router (R1)
#
# This file controls which FRRouting daemons are enabled.
# For ECMP testing, we need zebra (kernel routing) and ospfd (OSPF protocol).
#
# Reference: https://docs.frrouting.org/en/latest/daemons.html
#

# Enable zebra daemon (required for all routing)
zebra=yes

# Enable OSPF daemon for dynamic routing
ospfd=yes

# Disable other daemons (not needed for ECMP testing)
bgpd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no

# Daemon options
zebra_options="  -A 127.0.0.1 -s 90000000"
ospfd_options="  -A 127.0.0.1"
